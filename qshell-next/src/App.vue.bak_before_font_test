function getDisplayFontName(fontStr: string) {
  if (!fontStr || fontStr.includes("-apple-system") || fontStr === defaultGlobalFont) {
    return "系统推荐默认";
  }
  const match = presetUiFonts.find(p => p.value === fontStr);
