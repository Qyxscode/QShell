  e.preventDefault();
}

function onSplitterMove(e: MouseEvent) {
  if (isDraggingLeftSplitter) {
    const newWidth = e.clientX - 12;
    if (newWidth >= 260 && newWidth <= 480) {
      leftPanelWidth.value = newWidth;
    }
  } else if (isDraggingLeftVerticalSplitter) {
