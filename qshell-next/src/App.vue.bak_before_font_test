const TOTAL_LEDS = 90; // 6行 x 15列 高密圆角矩形灯阵 (多增加两排)

function calculateLedActiveCount(speedStr: string): number {
  if (!speedStr || sessions.value.length === 0) return 0;
  const s = speedStr.trim().toUpperCase();
  const m = s.match(/([0-9]+(?:\.[0-9]+)?)\s*([A-Z\/]+)/);
  if (!m) return 0;
  const val = parseFloat(m[1]);
  const unit = m[2];
  if (val <= 0) return 0;

  // 统一换算为 KB/s
  let kbps = 0;
  if (unit.includes("GB")) {
    kbps = val * 1024.0 * 1024.0;
  } else if (unit.includes("MB")) {
    kbps = val * 1024.0;
  } else if (unit.includes("KB")) {
    kbps = val;
  } else {
    kbps = val / 1024.0;
  }

  // 科学真实网络刻度（共 90 颗灯珠，每排 15 颗）：
  // - 10 KB/s 以下（心跳/闲置）：1 ~ 2 颗
  // - 100 KB/s：~4 颗（仅第一排起头）
  // - 500 KB/s：~10 颗（第一排大部分）
  // - 1 MB/s (1024 KB/s)：15 颗（刚满第 1 排）
  // - 5 MB/s：~30 颗（第 2 排满）
  // - 15 MB/s（百兆宽带满载）：~45 颗（第 3 排满，正好一半）
  // - 50 MB/s：~60 颗（第 4 排满）
  // - 100 MB/s（千兆跑满）：90 颗（6 排全满）
  let count = 0;
  if (kbps < 1.0) {
    count = 1;
  } else if (kbps <= 1024.0) {
    // 1 KB/s ~ 1024 KB/s: 映射到 1 ~ 15 颗 (第一排范围)
    const logRatio = Math.log10(kbps) / Math.log10(1024.0); // 0 ~ 1
    count = Math.max(1, Math.round(1 + logRatio * 14));
  } else if (kbps <= 102400.0) {
    // 1 MB/s ~ 100 MB/s: 映射到 16 ~ 90 颗 (第 2 ~ 6 排范围)
    const logRatio = Math.log10(kbps / 1024.0) / Math.log10(100.0); // 0 ~ 1
    count = Math.round(15 + logRatio * 75);
  } else {
    count = TOTAL_LEDS;
  }
  return Math.max(1, Math.min(TOTAL_LEDS, count));
}

const activeUpLedCount = computed(() => calculateLedActiveCount(monitorStats.value.net_up));
const activeDownLedCount = computed(() => calculateLedActiveCount(monitorStats.value.net_down));

// 单颗灯珠高亮流光游标与后随 3 颗渐变尾焰：通过定时器顺序逐颗推进
const upRunnerIdx = ref(0);
const downRunnerIdx = ref(0);
let upRunnerTimer: number | null = null;
let downRunnerTimer: number | null = null;

// 游标流动的单步间隔时间：严格设定为 0.7 秒 (700ms) 跳一格
const RUNNER_INTERVAL_MS = 700;

// 计算灯珠在彗星流光中的身份：0=头部高亮, 1=尾焰第1级, 2=尾焰第2级, 3=尾焰第3级, -1=普通背景
function getRunnerLevel(idx: number, runnerHead: number, maxCount: number): number {
  if (runnerHead <= 0 || maxCount <= 0 || idx > maxCount) return -1;
  const diff = runnerHead - idx;
  // 严格只有在游标身后的 3 颗才作为尾焰 (diff: 0, 1, 2, 3)
  if (diff >= 0 && diff <= 3) return diff;
  return -1;
}

watch(activeUpLedCount, (count) => {
  if (upRunnerTimer) {
    clearInterval(upRunnerTimer);
    upRunnerTimer = null;
  }
  if (count <= 0) {
    upRunnerIdx.value = 0;
    return;
  }
  // 步长上限扩展为 count + 4，保证最后一颗灯珠的尾焰完全淡出消失后，经过一个完整的静默拍，再从第 1 颗重新开始
  const maxStep = count + 4;
  if (upRunnerIdx.value > maxStep) upRunnerIdx.value = 1;
  upRunnerTimer = window.setInterval(() => {
    upRunnerIdx.value = (upRunnerIdx.value % maxStep) + 1;
  }, RUNNER_INTERVAL_MS);
}, { immediate: true });

watch(activeDownLedCount, (count) => {
  if (downRunnerTimer) {
    clearInterval(downRunnerTimer);
    downRunnerTimer = null;
  }
  if (count <= 0) {
    downRunnerIdx.value = 0;
    return;
  }
  const maxStep = count + 4;
  if (downRunnerIdx.value > maxStep) downRunnerIdx.value = 1;
  downRunnerTimer = window.setInterval(() => {
    downRunnerIdx.value = (downRunnerIdx.value % maxStep) + 1;
  }, RUNNER_INTERVAL_MS);
}, { immediate: true });

