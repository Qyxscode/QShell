  border-color: #3D4457;
}

/* 拖拽排序交互视觉反馈 */
.host-card.is-dragging {
  opacity: 0.45;
  transform: scale(0.98);
  border-style: dashed;
  border-color: var(--color-primary);
  cursor: grabbing;
}

.host-card.is-drag-over {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 2px var(--color-primary), 0 8px 20px rgba(0, 0, 0, 0.25);
  transform: translateY(-4px);
}

/* 通知点击高亮：边框平缓呼吸灯，循环3次 (每轮 1.6s，总计 4.8s) */
.host-card.breathing-highlight {
  animation: cardBreathingGlow 1.6s ease-in-out 3;
  z-index: 5;
}

@keyframes cardBreathingGlow {
  0% {
    border-color: var(--border-card);
    box-shadow: 0 0 0 0 transparent;
  }
  50% {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 4px var(--border-focus), 0 0 16px var(--border-focus);
  }
  100% {
    border-color: var(--border-card);
    box-shadow: 0 0 0 0 transparent;
  }
}

.card-pillar {
