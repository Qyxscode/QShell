{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QShell",
  "version": "0.99.71",
  "mainBinaryName": "QShell",
  "identifier": "com.a6704.qshell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QShell",
        "width": 1655,
        "height": 870,
        "minWidth": 1080,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "backgroundColor": "#00000000",
        "additionalBrowserArgs": "--disable-background-timer-throttling --disable-backgrounding-occluded-windows --disable-renderer-backgrounding --disable-features=CalculateNativeWinOcclusion",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
