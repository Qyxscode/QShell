{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "QShell",
    "version": "1.0.0",
    "mainBinaryName":  "QShell",
    "identifier":  "com.a6704.qshell",
    "build":  {
    "beforeDevCommand": "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "label":  "main",
                                    "title":  "QShell",
                                    "width":  1655,
                                    "height":  870,
                                    "minWidth":  1080,
                                    "minHeight":  640,
                                    "decorations":  false,
                                    "transparent":  false,
                                    "shadow":  true,
                                    "visible":  false,
                                    "backgroundColor":  "#151517",
                                    "additionalBrowserArgs":  "--disable-background-timer-throttling --disable-backgrounding-occluded-windows --disable-renderer-backgrounding --disable-features=CalculateNativeWinOcclusion",
                                    "dragDropEnabled":  true
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "nsis":  {
                                                "languages":  [
                                                                  "SimpChinese"
                                                              ],
                                                "displayLanguageSelector":  false,
                                                "installerIcon":  "icons/icon.ico",
                                                "installerHooks":  "installer-hooks.nsh",
                                                "installMode":  "currentUser"
                                            }
                               },
                   "createUpdaterArtifacts":  true
               },
    "plugins":  {
                    "updater":  {
                                    "endpoints":  [
                                                      "https://github.com/Qyxscode/QShell/releases/latest/download/latest.json"
                                                  ],
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyQkI0MEQ0RTgxNzM2NzYKUldSMk5oZm8xRUM3WXYwaGpUR2FhVFdNOThQTUJ2dHdMSzhTb1AwU3JwQlozK2JZa2pzcUV5OTcK"
                                }
                }
}
